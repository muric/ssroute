#!/bin/sh
set -e
mkdir -p /etc/ssroute
if [ ! -f /etc/ssroute/ssroute.conf ]; then
CREATED_DEFAULT_CONF=0
mkdir -p /etc/ssroute
if [ ! -f /etc/ssroute/ssroute.conf ]; then
    cp /etc/ssroute/ssroute.conf.example /etc/ssroute/ssroute.conf
    CREATED_DEFAULT_CONF=1
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    if [ "$CREATED_DEFAULT_CONF" -eq 0 ]; then
        systemctl enable --now ssroute || true
    else
        systemctl enable ssroute || true
    fi
fi

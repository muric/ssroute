#!/bin/sh
set -e
mkdir -p /etc/ssroute
if [ ! -f /etc/ssroute/ssroute.conf ]; then
CREATED_DEFAULT_CONF=0
mkdir -p /etc/ssroute
if [ ! -f /etc/ssroute/ssroute.conf ]; then
    cp /etc/ssroute/ssroute.conf.example /etc/ssroute/ssroute.conf
    CREATED_DEFAULT_CONF=1
fi

case "$1" in
    configure)
        mkdir -p /etc/ssroute
        if [ ! -f /etc/ssroute/ssroute.conf ]; then
            cp /etc/ssroute/ssroute.conf.example /etc/ssroute/ssroute.conf
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable --now ssroute || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        # No special actions needed on abort for now.
        ;;

    *)
        # No-op for other arguments (e.g. triggered).
        ;;
esac
